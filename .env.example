# Payload CMS
PAYLOAD_SECRET=replace-with-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001
PAYLOAD_REVALIDATE=60

# Shared
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=replace-with-random-string

# Seed admin (only used on first run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123

# Production (docker-compose.prod.yml)
FRONTEND_DOMAIN=portal.example.com
CMS_DOMAIN=cms.example.com

# Oeffentliche Basis-URL des Frontends (fuer kanonische Links, Open Graph, Teilen-URLs).
# Das Frontend liest SITE_URL zur Laufzeit, ein Rebuild ist nicht noetig. Bleibt
# die Variable leer, leitet das Frontend die URL aus dem Request-Host ab
# (Host bzw. X-Forwarded-Host/-Proto).
# Beispiel Direktzugriff per IP:
SITE_URL=http://178.104.68.119:3000
# Beispiel mit Domain hinter Reverse-Proxy:
# SITE_URL=https://portal.example.com

# Alternative: NEXT_PUBLIC_SITE_URL hat Vorrang, landet aber zur Build-Zeit fest
# im Bundle und ignoriert spaetere Aenderungen der Umgebungsvariable. Nur setzen,
# wenn die Domain schon beim Build feststeht.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
